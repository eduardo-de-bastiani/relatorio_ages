{
  "schema_version": 1,
  "phase": "pilot",
  "source": "RELATORIO_ATUAL.odt",
  "manifest": "docs/CONTENT_MANIFEST.json",
  "destination_root": "relatorio_AGES_eduardo",
  "ledger_directory": "migration/ledgers",
